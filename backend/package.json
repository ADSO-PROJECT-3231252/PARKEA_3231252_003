{
  "name": "parkea-backend",
  "version": "1.0.0",
  "description": "PARKEA (SIGMUI) - API REST for urban parking management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.1",
    "nodemailer": "^10.1.7",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "jest": {
    "verbose": true,
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
