# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/parkea_db

# Integration tests (npm run test:integration, #373): a MySQL database only
# for them. Its name must end in _test, because the tests delete it and build
# it again with the migrations and the seeders.
TEST_DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/parkea_test

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# CORS
FRONTEND_URL=http://localhost:5173

#MAILTRAP
# Sender of the emails. Leave it empty on your computer (Mailtrap accepts any);
# the published site uses no-reply@parkeaweb.me (docs/deployment.md).
MAIL_FROM=
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
